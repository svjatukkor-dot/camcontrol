{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CamControl",
  "version": "0.1.0",
  "identifier": "dev.camcontrol.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "CamControl",
        "width": 1100,
        "height": 760,
        "minWidth": 820,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:; connect-src 'self'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
